# =============================================================================
# TKG CRM - environment. PLACEHOLDERS ONLY. Never commit real values.
#
# On the server: crm/scripts/server.sh (run by sudo ./update.sh) writes
#   /etc/tkg-crm.env with generated secrets the first time and keeps them.
#   You never need to create this by hand there.
# Local development: copy to .env.local; the database is
#   `npm run db:start` (PostgreSQL 17 in Docker on 127.0.0.1:55432).
#
# NOTHING here is NEXT_PUBLIC_: none of it can reach a browser.
# =============================================================================

# Public address of the CRM, including /crm, no trailing slash.
APP_URL=https://example.invalid/crm

# The app's own database login (tkg_crm_app). It has no rights of its own:
# every query switches to anon / authenticated / service_role, and row level
# security decides. Read ONLY by src/lib/db/pool.ts (the build checks this).
DATABASE_URL=postgres://tkg_crm_app:replace-me@127.0.0.1:5432/tkg_crm

# Where uploaded documents are stored (outside the web root).
DOCUMENTS_DIR=/var/lib/tkg-crm/documents

# 32+ random characters. Keys the login-lockout email hash.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
CRM_SESSION_SECRET=replace-with-48-random-bytes-base64

# --- Website ingestion -------------------------------------------------------
# Shared HMAC secret. The SAME value is CRM_INGEST_SECRET in the website's
# environment (server.sh sets both).
CRM_INGEST_SECRET=replace-with-48-random-bytes-base64
# Optional, only while rotating: the previous secret, still accepted.
CRM_INGEST_SECRET_PREVIOUS=

# --- Daily job -----------------------------------------------------------------
# The 08:00 timer calls /crm/api/cron/digest with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=replace-with-48-random-bytes-base64
# Resend key and sender for the reminder email. Blank = no email (tasks still
# appear in the CRM).
RESEND_API_KEY=
DIGEST_FROM_EMAIL=TKG CRM <crm@example.invalid>
