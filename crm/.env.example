# =============================================================================
# TKG CRM - environment. PLACEHOLDERS ONLY. Never commit real values.
#
# Local: copy to .env.local and fill from `npx supabase status -o env`
#        (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
# Production: set each in the Vercel project "tkg-crm" (Root Directory: crm).
#        None of these are shared with the marketing site's Vercel project.
#
# NOTHING here is NEXT_PUBLIC_. The browser never talks to Supabase's API
# directly, so no key is shipped to it.
# =============================================================================

# Public origin of the CRM, no trailing slash. Used in auth email links.
APP_URL=https://crm.example.invalid

# Supabase project (region ca-central-1). Server-only.
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key. Server-only in this app, on purpose: keeping it
# out of the browser means login lockout cannot be bypassed.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Secret ("service role") key. BYPASSES ROW LEVEL SECURITY.
# Read ONLY by src/lib/supabase/service-role.ts, which is imported ONLY by the
# modules allow-listed in scripts/check-service-role.mjs (user administration
# now; ingestion and cron in later phases). The build fails otherwise.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_placeholder

# 32+ random bytes, base64. Signs the session-timing cookie (idle 30 min
# admin / 2 h rep, absolute 12 h) and keys the login-lockout email hash.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
CRM_SESSION_SECRET=replace-with-48-random-bytes-base64
