# Absolute origin used for canonical URLs, Open Graph tags and sitemap.xml.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-real-domain.com

# --- /admin ---------------------------------------------------------------
# The owner's password for /admin. /admin is DISABLED until this is set;
# there is no default. Use a long random string.
ADMIN_PASSWORD=

# Optional. Separate cookie-signing secret, so changing the password does not
# log the owner out everywhere. Defaults to the password if unset.
ADMIN_SECRET=

# Optional. Where submissions, uploads and /admin overrides are stored.
# Defaults to ./data, or /tmp/tkg-data on a serverless host where nothing else
# is writable. Must be a persistent disk to survive - see src/lib/store.ts.
TKG_DATA_DIR=

# --- address autocomplete -------------------------------------------------
# OPTIONAL. LEAVE THIS EMPTY unless you want to.
#
# Address autocomplete works with no key and no account: it runs on Photon
# (OpenStreetMap), searching the Fraser Valley and Lower Mainland first and
# the rest of Canada second. Postal codes, partial street names and civic
# addresses all resolve. Nothing to sign up for, no billing, no expiry.
#
# The one thing it is weaker at is brand-new subdivisions and unit numbers
# inside a building, because those depend on OpenStreetMap coverage. If that
# ever becomes a problem, add a Google key here and the route switches over
# on its own - no code change.
#
# To do that: console.cloud.google.com, enable "Places API (New)", and
# restrict the key BY IP - it is used server-side
# (src/app/api/address/route.ts), so an HTTP-referrer restriction will not
# work.
GOOGLE_MAPS_API_KEY=

# --- where inquiries go ---------------------------------------------------
# On a host with no persistent disk (Vercel, Netlify, Lambda) the data store
# cannot keep a submission, so email is how a lead actually reaches you.
# See src/app/api/inquiry/route.ts.

# THE ONE TO SET. Get it from resend.com/api-keys. On its own this turns
# email on: every inquiry is sent from mail@kaisoul.tech to
# info@tkgventuresltd.ca, with any uploaded resume, photos or bill attached,
# and Reply-To set to the customer so hitting reply answers them directly.
#
# BEFORE IT WILL DELIVER: verify kaisoul.tech in Resend (Domains > Add
# domain, then add the DNS records it shows). Without that, Resend accepts
# the request and quietly drops the mail.
RESEND_API_KEY=

# Optional overrides of the two addresses above. INQUIRY_TO_EMAIL accepts a
# comma-separated list. Whatever INQUIRY_FROM_EMAIL is, its domain must be
# verified in Resend.
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Optional, and independent of email. POST each submission as JSON to
# Zapier, Make, n8n, a Google Sheet webhook, or a CRM endpoint.
INQUIRY_WEBHOOK_URL=
